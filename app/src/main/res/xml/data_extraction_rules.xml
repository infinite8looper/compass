<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the waypoint database and the settings file are backed up or transferred; everything else is left out
  because an <include> turns off the default of including all app data.

  The system also copies the journal and log files that lie next to a listed database (-journal, -wal), listed or
  not. The app sets its database to keep no write-ahead log and to empty its journal after every change, and the
  backup agent hands nothing over in a pass where one of those files holds any bytes.

  Cloud backup happens only when the device can encrypt the backup end to end (a screen lock is set).
  Device-to-device transfer does not depend on that.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="waypoints.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="waypoints.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
