<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The watch's own theme, without the window's swipe-to-dismiss: on the three side-by-side screens a right
         swipe turns to the next screen and never closes the app. The screens opened from a row are swiped back by
         the navigation host, which does not depend on this. Lint's advice against switching it off is about apps
         that would then have no way back; here the swipe has another meaning, by design. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSwipeToDismiss" tools:ignore="WearBackNavigation">false</item>
    </style>
</resources>
